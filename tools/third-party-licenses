def normalized(name):
    return re.sub(r"[-_.]+", "-", name).lower()


def crate_notices(package):
    """Each license or notice file in the crate, and, for a crate inside a git checkout, the checkout's own."""
    directory = Path(package["manifest_path"]).parent
    if not directory.is_dir():
        raise ValueError(f"crate source is not available: {directory}; run cargo fetch")
    files = [(path, path.relative_to(directory).as_posix()) for path in legal_files(directory)]
    explicit = package.get("license_file")
    if explicit:
        path = directory / explicit
        if not path.is_file():
            raise ValueError(f"missing license-file for {package['name']}: {explicit}")
        files.append((path, explicit))
    if package["source"].startswith("git+") and not (directory / ".git").exists():
        for ancestor in directory.parents:
            files.extend((path, "checkout/" + path.relative_to(ancestor).as_posix())
                         for path in legal_files(ancestor, recursive=False))
            if (ancestor / ".git").exists():
                break
            if ancestor.parent == ancestor:
                raise ValueError(f"cannot find the git checkout of {package['name']}")
    return files


def crate_source(name, version, source):
    if source.startswith("registry+") and "crates.io" in source:
        return f"Source: https://crates.io/api/v1/crates/{name}/{version}/download"
    if source.startswith("git+"):
        url, _, revision = source[len("git+"):].partition("#")
        return f"Source: {url.split('?')[0]} at revision {revision}"
    return f"Source: {source}"


def suggest_pacman(binaries):
    """The Arch packages owning the shared libraries the given binaries link directly (DT_NEEDED)."""
    libraries = set()
    for binary in binaries:
        needed = set(re.findall(r"\(NEEDED\)\s+Shared library: \[([^\]]+)\]", run(["readelf", "-d", binary], Path.cwd(), {"LC_ALL": "C"})))
        for line in run(["ldd", binary], Path.cwd(), {"LC_ALL": "C"}).splitlines():
            match = re.match(r"\s*(\S+)\s+=>\s*(/\S+)", line)
            if match and match.group(1) in needed:
                libraries.add(os.path.realpath(match.group(2)))
    if not libraries:
        return []
    # pacman exits 1 when some library belongs to no package (a build folder's own); keep the rest.
    owners = subprocess.run(["pacman", "-Qqo", *sorted(libraries)], stdout=subprocess.PIPE,
                            env=dict(os.environ, LC_ALL="C")).stdout.decode().split()
    base = {"glibc", "gcc-libs", "libgcc", "libstdc++", "libgomp", "lib32-glibc", "lib32-gcc-libs"}
    return sorted(set(owners) - base)


def init(root, path, project):
    if path.exists():
        raise ValueError(f"{path} already exists")
    found = [name for name, marker in (("cargo", "Cargo.lock"), ("go", "go.sum"), ("npm", "package-lock.json"),
                                       ("python", "pyproject.toml")) if (root / marker).is_file()]
    native = any((root / m).is_file() for m in ("CMakeLists.txt", "meson.build")) or any(root.glob("*.pro"))
    text = [f"# Read by tools/third-party-licenses; run it after changing anything here or any dependency.",
            f'project = "{project}"', "",
            "# Licenses shipped components may use. deny.toml's [licenses] allow, when present, wins.",
            "allow = [" + ", ".join(f'"{a}"' for a in DEFAULT_ALLOW) + "]", ""]
    if "cargo" in found:
        text += ["[cargo]", 'targets = ["x86_64-unknown-linux-gnu", "aarch64-unknown-linux-gnu"]',
                 '# binaries = ["name"]          # default: every binary in the workspace', ""]
    if "go" in found:
        text += ["[go]", 'packages = ["./..."]', 'targets = ["linux/amd64", "linux/arm64"]',
                 '# licenses = { "example.com/module" = "MIT" }', ""]
    if "npm" in found:
        text += ["[npm]", "dev = false   # true when a bundler (Vite, esbuild...) ships devDependencies",
                 '# licenses = { "package" = "MIT" }', ""]
    if "python" in found:
        text += ["[python]", 'interpreter = ".venv/bin/python"', '# licenses = { "Package" = "MIT" }', ""]
    if native:
        text += ["# The system libraries the binary links; tools/third-party-licenses --suggest-pacman BINARY",
                 "[pacman]", "packages = []", '# licenses = { "qt6-base" = "LGPL-3.0-only" }', ""]
    text += ["# Vendored code, icons, fonts... one block each; their texts go in LICENSES/.",
             "# [[component]]", '# name = "Lucide"', '# version = "0.468.0"', '# source = "https://lucide.dev"',
             '# spdx = "ISC"', '# files = ["LICENSES/ISC-lucide.txt"]', '# paths = ["assets/icons"]', ""]
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text("\n".join(text))
    return found + (["pacman"] if native else [])


def main():
    parser = argparse.ArgumentParser(description=__doc__.split("\n")[0])
    parser.add_argument("--check", action="store_true", help=f"fail if {OUTPUT} is stale")
    parser.add_argument("--init", metavar="PROJECT", help=f"write a starter {CONFIG} for the named project")
    parser.add_argument("--suggest-pacman", nargs="+", metavar="BINARY",
                        help="print the Arch packages whose libraries the binaries load")
    parser.add_argument("--root", type=Path, help="the project (default: this script's parent's parent)")
    parser.add_argument("--config", type=Path, help=f"default: ROOT/{CONFIG}")
    parser.add_argument("--output", type=Path, help=f"default: ROOT/{OUTPUT}")
    args = parser.parse_args()
    root = (args.root or Path(__file__).resolve().parent.parent).resolve()
    config_path = args.config or root / CONFIG
    if args.suggest_pacman:
        print("\n".join(suggest_pacman(args.suggest_pacman)))
        return
    if args.init:
        found = init(root, config_path, args.init)
        print(f"WROTE {config_path}: {', '.join(found) or 'no ecosystem found; add [[component]] blocks'}")
        return
    if not config_path.is_file():
        raise ValueError(f"{config_path} is missing; create it with --init PROJECT")
    config = tomllib.loads(config_path.read_text())
    shown = config_path.relative_to(root).as_posix() if config_path.is_relative_to(root) else config_path.name
    report = Report(root, config, shown)
    for key, _ in SECTIONS:
        if key in config:
            getattr(report, key)(config[key])
    content = report.render(config["project"], config.get("license", "LICENSE"))
    output = args.output or root / config.get("output", OUTPUT)
    if args.check:
        if not output.is_file() or output.read_bytes() != content.encode("utf-8"):
            raise ValueError(f"{output.name} is stale; run make licenses")
    else:
        output.write_bytes(content.encode("utf-8"))
    print(f"{'PASS' if args.check else 'WROTE'} {output.name}: {len(content.encode('utf-8'))} bytes; "
          f"package licenses: {' '.join(sorted(report.licenses))}")


if __name__ == "__main__":
    try:
        main()
    except (ValueError, OSError, KeyError, subprocess.CalledProcessError) as error:
        sys.exit(f"FAIL third-party licenses: {error}")
