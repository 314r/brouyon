OUTPUT = "THIRD-PARTY-LICENSES.txt"
CONFIG = "tools/third-party-licenses.toml"
LEGAL = ("LICENSE", "LICENCE", "COPYING", "NOTICE", "UNLICENSE")
CODE = {".c", ".cc", ".cjs", ".cpp", ".css", ".go", ".h", ".hpp", ".html", ".java", ".js", ".json",
        ".map", ".mjs", ".py", ".pyc", ".rs", ".ts", ".tsx", ".jsx"}
DEFAULT_ALLOW = ["0BSD", "Apache-2.0", "Apache-2.0 WITH LLVM-exception", "BlueOak-1.0.0", "BSD-2-Clause",
                 "BSD-3-Clause", "BSL-1.0", "CC-BY-4.0", "CC0-1.0", "CDLA-Permissive-2.0", "CC-BY-3.0", "HPND", "ISC", "MIT",
                 "MIT-0", "MIT-CMU", "MPL-2.0", "OFL-1.1", "PSF-2.0", "Python-2.0", "Unicode-3.0", "Unicode-DFS-2016",
                 "Unlicense", "Zlib"]
# Sections in the order they are written; pacman's system libraries are not shipped, so their
# licenses are listed but neither checked against the allowed list nor counted as package licenses.
SECTIONS = (("cargo", "CRATES"), ("go", "GO MODULES"), ("npm", "NPM PACKAGES"),
            ("python", "PYTHON PACKAGES"), ("component", "VENDORED COMPONENTS"),
            ("pacman", "SYSTEM LIBRARIES"))
NOT_SHIPPED = {"pacman"}


# "MIT OR Apache-2.0", "(MIT AND Zlib) OR ISC" and "MIT/Apache-2.0" parse; "MIT OR" and "(MIT" raise ValueError.
def alternatives(expression):
    """The license sets an SPDX expression allows, one per OR branch; Cargo's older `/` means OR."""
    expression = expression.replace("/", " OR ")
    tokens = re.findall(r"\(|\)|[A-Za-z0-9.+-]+", expression)
    if not tokens or re.sub(r"\s+", "", expression) != "".join(tokens):
        raise ValueError(f"invalid SPDX expression: {expression}")
    position = 0

    def term():
        nonlocal position
        if position == len(tokens):
            raise ValueError(f"incomplete SPDX expression: {expression}")
        token = tokens[position]
        position += 1
        if token == "(":
            result = either()
            if position == len(tokens) or tokens[position] != ")":
                raise ValueError(f"unclosed SPDX expression: {expression}")
            position += 1
            return result
        if token in {"AND", "OR", "WITH", ")"}:
            raise ValueError(f"unexpected SPDX token: {token}")
        if position < len(tokens) and tokens[position] == "WITH":
            position += 1
            if position == len(tokens) or tokens[position] in {"AND", "OR", "WITH", "(", ")"}:
                raise ValueError(f"missing SPDX exception: {expression}")
            token += " WITH " + tokens[position]
            position += 1
        return [frozenset([token])]

    def both():
        nonlocal position
        result = term()
        while position < len(tokens) and tokens[position] == "AND":
            position += 1
            right = term()
            result = [a | b for a in result for b in right]
        return result

    def either():
        nonlocal position
        result = both()
        while position < len(tokens) and tokens[position] == "OR":
            position += 1
            result += both()
        return result

    result = either()
    if position != len(tokens):
        raise ValueError(f"unexpected SPDX suffix: {expression}")
    return result


def preferred(choices):
    return min(choices, key=lambda c: ("MIT" not in c, "Apache-2.0" not in c, len(c), sorted(c)))


def chosen_license(expression, allowed, who):
    """The allowed alternative, preferring MIT, then Apache-2.0, then the fewest terms."""
    if not expression:
        raise ValueError(f"{who} has no SPDX license; set one in {CONFIG}")
    choices = [choice for choice in alternatives(expression) if choice <= allowed]
    if not choices:
        raise ValueError(f"{who}: {expression} is not among the allowed licenses")
    return preferred(choices)


# Phrases that identify a license text, checked on lowercased text with comment marks and line
# breaks folded away. Copyleft families are recognized only to be refused: their version and
# "or later" choice must be read by a person and written in the config.
SIGNATURES = (
    ("Apache-2.0", ("apache license", "version 2.0"), ()),
    ("MPL-2.0", ("mozilla public license", "2.0"), ()),
    ("copyleft:AGPL", ("gnu affero general public license version 3",), ()),
    ("copyleft:LGPL", ("gnu lesser general public license version",), ()),
    ("copyleft:LGPL", ("gnu library general public license version",), ()),
    ("copyleft:GPL", ("gnu general public license version",), ()),
    ("copyleft:GPL", ("general public license as published by the free software foundation",), ()),
    ("Unlicense", ("this is free and unencumbered software released into the public domain",), ()),
    ("CC0-1.0", ("cc0 1.0 universal",), ()),
    ("BSL-1.0", ("boost software license - version 1.0",), ()),
    ("Zlib", ("altered source versions must be plainly marked as such",
              "permission is granted to anyone to use this software for any purpose"), ()),
    ("ISC", ("permission to use, copy, modify, and/or distribute this software for any purpose",
