+    /// Run under the shim, which writes "theirs" over the target between the check
+    /// and the act, once, when a file called `.race` is beside it.
+    fn arm(dir: &Path) {
+        fs::write(dir.join(".race"), "").unwrap();
+    }
+
+    fn theirs_is_somewhere(dir: &Path) -> bool {
+        [dir.to_path_buf(), dir.join(".trash")].iter().any(|dir| {
+            fs::read_dir(dir).unwrap().any(|entry| {
+                fs::read_to_string(entry.unwrap().path()).is_ok_and(|text| text == "theirs")
+            })
+        })
+    }
+
+    #[test]
+    fn replay_gap_save() {
+        let (dir, store) = store();
+        let id = store.create("loaded").unwrap();
+        arm(dir.path());
+        eprintln!("{:?}", store.save(&id, "loaded", "mine"));
+        assert!(!dir.path().join(".race").exists(), "the shim never acted");
+        assert!(theirs_is_somewhere(dir.path()));
+    }
+
+    #[test]
+    fn replay_gap_remove() {
+        let (dir, store) = store();
+        let id = store.create("loaded").unwrap();
+        arm(dir.path());
+        eprintln!("{:?}", store.remove_unchanged(&id, "loaded"));
+        assert!(!dir.path().join(".race").exists(), "the shim never acted");
+        assert!(theirs_is_somewhere(dir.path()));
+    }
+
+    #[test]
+    fn replay_gap_create() {
+        let (dir, store) = store();
+        arm(dir.path());
+        eprintln!("{:?}", store.create("mine"));
+        assert!(!dir.path().join(".race").exists(), "the shim never acted");
+        assert!(theirs_is_somewhere(dir.path()));
+    }
+
+    #[test]
+    fn replay_gap_trash() {
+        let (dir, store) = store();
+        let id = store.create("mine").unwrap();
+        arm(&dir.path().join(".trash"));
+        eprintln!("{:?}", store.trash(&id));
+        assert!(!dir.path().join(".trash/.race").exists(), "the shim never acted");
+        assert!(theirs_is_somewhere(dir.path()));
+    }
+
+    #[test]
+    fn replay_gap_restore() {
+        let (dir, store) = store();
+        fs::write(dir.path().join(".trash/a.md"), "mine").unwrap();
+        arm(dir.path());
+        eprintln!("{:?}", store.restore("a.md"));
+        assert!(!dir.path().join(".race").exists(), "the shim never acted");
+        assert!(theirs_is_somewhere(dir.path()));
+    }
