# Built from this checkout rather than a release tarball. Keep pkgver in step with
# Cargo.toml.
pkgname=brouyon
pkgver=0.1.0
pkgrel=1
pkgdesc='Quick-capture markdown notes for Omarchy'
arch=('x86_64')
url='https://github.com/314r/brouyon'
license=('MIT')
# The first three are linked. Wayland and Vulkan are loaded at run time, fontconfig
# answers which font is current, and the portal is the folder picker.
depends=('libxcb' 'libxkbcommon' 'libxkbcommon-x11' 'wayland' 'vulkan-icd-loader' 'fontconfig' 'xdg-desktop-portal')
# No rust or cargo here: Rust comes from mise.toml, and makepkg -s would otherwise
# install a second copy system-wide.
makedepends=('clang' 'cmake')
# Keeps makepkg's LTO flags away from the C libraries some crates build, and skips a
# debug package nobody installs.
options=('!lto' '!debug')
source=()
sha256sums=()

build() {
  cd "$startdir/.."
  ./bin/build
}

package() {
  cd "$startdir/.."
  install -Dm755 target/release/brouyon "$pkgdir/usr/bin/brouyon"
  install -Dm644 LICENSE THIRD-PARTY-LICENSES.txt -t "$pkgdir/usr/share/licenses/$pkgname"
  install -Dm644 "$startdir/brouyon.svg" "$pkgdir/usr/share/icons/hicolor/scalable/apps/brouyon.svg"
  install -Dm644 "$startdir/brouyon.desktop" "$pkgdir/usr/share/applications/brouyon.desktop"
}
