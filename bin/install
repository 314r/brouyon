#!/bin/sh
# Builds Brouyon and installs it. Run it again to update.
#
# On Omarchy it becomes an Arch package, which puts it in the launcher, and pacman asks
# for your password. On macOS it becomes Brouyon.app, in your Applications folder.
set -eu

cd "$(dirname "$0")/.."

if [ "$(uname -s)" = Darwin ]; then
    bin/build
    app=target/release/Brouyon.app
    rm -rf "$app"
    mkdir -p "$app/Contents/MacOS" "$app/Contents/Resources"
    cp target/release/brouyon "$app/Contents/MacOS/"
    version=$(sed -n 's/^version = "\(.*\)"$/\1/p' Cargo.toml | head -n 1)
    sed "s/@VERSION@/$version/g" macos/Info.plist >"$app/Contents/Info.plist"
    cp macos/brouyon.icns LICENSE THIRD-PARTY-LICENSES.txt "$app/Contents/Resources/"
    # Signed for this Mac alone: Apple silicon runs nothing unsigned, and a signature
    # that works on other Macs needs an Apple developer account.
    codesign --force --sign - "$app"

    # The shared folder takes an administrator's account, and the user's own any other.
    applications=/Applications
    [ -w "$applications" ] || applications="$HOME/Applications"
    mkdir -p "$applications"
    rm -rf "$applications/Brouyon.app"
    cp -R "$app" "$applications/"
    echo "Installed in $applications. Open Brouyon from Launchpad or Spotlight."
    exit
fi

cd pkgbuild
makepkg -fsi "$@"

# Brouyon used to install itself by hand. A user's own desktop entry and icon override
# a package's, so those copies have to go. Notes and settings are elsewhere.
data="${XDG_DATA_HOME:-$HOME/.local/share}"
rm -f "$HOME/.local/bin/brouyon" \
    "$data/applications/brouyon.desktop" \
    "$data/icons/hicolor/scalable/apps/brouyon.svg"
if command -v update-desktop-database >/dev/null && [ -d "$data/applications" ]; then
    update-desktop-database "$data/applications"
fi

echo "Installed. Brouyon is in the Omarchy launcher, or run: brouyon"
